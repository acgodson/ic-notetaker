{
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "name": "ic_notetaker",
  "version": "0.0.42",
  "scripts": {
    "prebuild": "npm run canisters:create && npm run cargo:build && npm run candid:extract && npm run candid:generate && npm run types:generate",
    "build": "npm run build --workspaces --if-present",
    "build:backend": "npm run prebuild && DFX_NETWORK=${DFX_NETWORK:-local} ./deploy.sh",
    "build:backend:local": "DFX_NETWORK=local npm run build:backend",
    "build:backend:ic": "DFX_NETWORK=ic npm run build:backend",
    "build:extension": "npm run prebuild && VITE_MODE=\"$(echo ${DFX_NETWORK:-production} | sed 's/local/development/')\" npm run build:extension --workspace=src/extension",
    "build:extension:local": "DFX_NETWORK=local npm run build:extension",
    "build:extension:ic": "DFX_NETWORK=ic npm run build:extension",
    "canisters:create": "npm run canisters:create:backend && npm run canisters:create:ii",
    "canisters:create:backend": "dfx canister create ic_notetaker_backend --network ${DFX_NETWORK:-local} || true",
    "canisters:create:ii": "if [ \"${DFX_NETWORK:-local}\" = \"local\" ]; then dfx canister create internet_identity --network local || true && dfx build internet_identity --network local || true; fi",
    "cargo:build": "cargo build --target wasm32-unknown-unknown --release -p ic_notetaker_backend",
    "candid:extract": "candid-extractor target/wasm32-unknown-unknown/release/ic_notetaker_backend.wasm > src/ic_notetaker_backend/ic_notetaker_backend.did",
    "candid:generate": "dfx generate ic_notetaker_backend --network ${DFX_NETWORK:-local} && if [ \"${DFX_NETWORK:-local}\" = \"local\" ]; then dfx generate internet_identity --network local || echo 'Warning: Internet Identity generation failed'; fi",
    "types:generate": "node src/extension/scripts/generate-types.js",
    "dev": "npm run dev --workspace=src/extension",
    "dev:backend": "dfx start --clean --background",
    "deploy": "./deploy.sh",
    "start": "npm start --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:integration": "tsx test.ts",
    "package:extension": "npm run package --workspace=src/extension",
    "release:extension": "npm run release --workspace=src/extension"
  },
  "type": "module",
  "workspaces": [
    "src/extension"
  ],
  "devDependencies": {
    "@dfinity/agent": "^2.1.1",
    "@dfinity/auth-client": "^2.1.1",
    "@dfinity/candid": "^2.1.1",
    "@dfinity/identity": "^2.1.1",
    "@dfinity/principal": "^2.1.1",
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/webextension-polyfill": "^0.12.3",
    "@vitejs/plugin-react": "^4.3.1",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "dotenv": "^16.3.1",
    "lucide-react": "^0.396.0",
    "postcss": "^8.4.39",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "rollup-plugin-copy": "^3.5.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.3.4",
    "vite-plugin-environment": "^1.1.3",
    "webextension-polyfill": "^0.12.0"
  }
}